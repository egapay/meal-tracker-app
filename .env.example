# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Both values are inlined into the JavaScript bundle at build time and are
# readable by anyone who views the deployed site. That is expected: the anon key
# is a public identifier, and Row Level Security is what actually protects the
# data. Never put the service_role key here -- it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional, build-time only (not read from this file -- set it in the shell or CI).
# Defaults to /meal-tracker-app/. Use / when serving from a domain root.
# BASE_PATH=/meal-tracker-app/
